{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "noEmit": true
  },
  "include": [
    "tests",
    "pages",
    "utils",
    "fixtures",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules",
    "custom-report",
    "playwright-report",
    "test-results",
    "logs"
  ]
}
